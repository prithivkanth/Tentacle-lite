<?xml version="1.0" ?>
<robot name="tentacle" xmlns:xacro="http://www.ros.org/wiki/xacro">

    

    <ros2_control type="system" name="RobotSystem">
        <xacro:if value="$(arg is_ignition)">
            <hardware>
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </hardware>
        </xacro:if>

        <xacro:unless value="$(arg is_ignition)">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
        </xacro:unless>


        <joint name="Revolute_1">
            <command_interface name="position">
                <param name="min">-3.141593</param>
                <param name="max">3.141593</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="Revolute_2">
            <command_interface name="position">
                <param name="min">-2.541593</param>
                <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="Revolute_3">
            <command_interface name="position">
                <param name="min">-3.141593</param>
                <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>


        <joint name="Revolute_4">
            <command_interface name="position">
                <param name="min">0.0</param>
                <param name="max">0.785398</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="Revolute_5">
    
            <param name="mimic">Revolute_4</param>
            <param name="multiplier">-1</param>
            
        </joint>
    </ros2_control>
</robot>