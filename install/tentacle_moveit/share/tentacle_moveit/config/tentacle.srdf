<?xml version="1.0" encoding="UTF-8"?>


<robot name="tentacle">
    
    <group name="arm">
        <joint name="virtual_joint"/>
        <joint name="Revolute_1"/>
        <joint name="Revolute_2"/>
        <joint name="Revolute_3"/>
        <joint name="Rigid"/>
       
    </group>

    <group name="gripper">
        
        <joint name="Revolute_4"/>
        <joint name="Revolute_5"/>

    </group>

    <group_state name="home" group="arm">
        <joint name="Revolute_1" value="0"/>
        <joint name="Revolute_2" value="0"/>
        <joint name="Revolute_3" value="0"/>
    </group_state>

    <group_state name="home" group="gripper">
        <joint name="Revolute_4" value="0"/>
    </group_state>

   
    <disable_collisions link1="base_link" link2="center_1" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="forearm_1" reason="Never"/>
    <disable_collisions link1="center_1" link2="forearm_1" reason="Adjacent"/>
    <disable_collisions link1="forearm_1" link2="arm_1" reason="Adjacent"/>
    <disable_collisions link1="forearm_1" link2="gripper_left_1" reason="Never"/>
    <disable_collisions link1="forearm_1" link2="gripper_right_1" reason="Never"/>
    <disable_collisions link1="gripper_base_1" link2="forearm_1" reason="Never"/>
    <disable_collisions link1="gripper_base_1" link2="arm_1" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_1" link2="gripper_left_1" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_1" link2="gripper_right_1" reason="Adjacent"/>
    <disable_collisions link1="gripper_left_1" link2="arm_1" reason="Never"/>
    <disable_collisions link1="gripper_right_1" link2="arm_1" reason="Never"/> 
    <disable_collisions link1="gripper_left_1" link2="gripper_right_1" reason="Adjacent"/>     
</robot>